# Explicit mock/hash test overrides, not the default application configuration.
# Compose: load .env first, then this file. Do not use on a production workspace.
LLM_PROVIDER=mock
LLM_MODEL=demo
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-test
EMBEDDING_DIMENSIONS=384
RETRIEVAL_MIN_SCORE=0.0

# Clear cloud credentials inherited from the first env file.
LLM_API_KEY=
EMBEDDING_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
ZHIPU_API_KEY=
BOCHA_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=
CONTEXT7_API_KEY=
AMAP_API_KEY=
QWEATHER_API_KEY=
QWEATHER_API_HOST=
OLLAMA_ENABLED=false
