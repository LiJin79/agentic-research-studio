# Knowledge Studio configuration template. Copy to .env for a new installation.
# Never commit real credentials. Optional integrations stay disabled without keys.

# Database and local development endpoints
# Replace the password and keep both DSN passwords consistent.
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=agent_db
POSTGRES_DSN=postgresql+asyncpg://agent_user:change-this-password@localhost:5433/agent_db
LANGGRAPH_POSTGRES_DSN=postgresql://agent_user:change-this-password@localhost:5433/agent_db
REDIS_URL=redis://localhost:6380/0
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=agent_documents

# Default cloud generation model
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# Optional generation providers for the model selector
# Qwen can reuse LLM_API_KEY when the default provider is dashscope.
# Adapter availability does not mean every provider has been live-verified.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MAX_TOKENS=8192
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_BASE_URL_DOCKER=http://ollama:11434

# Embedding model: dimensions must match the API response
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

# Web search: configure only the provider you use
WEB_SEARCH_PROVIDER=bocha
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# Optional read-only integrations; see docs/tools.md for capability boundaries
GITHUB_TOKEN=
CONTEXT7_API_KEY=
AMAP_API_KEY=
QWEATHER_API_KEY=
QWEATHER_API_HOST=
TOOL_TIMEOUT_SECONDS=15
TOOL_MAX_RESPONSE_BYTES=2000000
TOOL_MAX_CALLS=9

# Access control, agent budgets, and cache
APP_ACCESS_TOKEN=
AGENT_MAX_REVISIONS=2
AGENT_MAX_TOOL_ITERATIONS=3
CHAT_TIMEOUT_SECONDS=300
CHAT_RATE_LIMIT_PER_MINUTE=30
HISTORY_MAX_CHARACTERS=12000
CONTEXT_MAX_CHARACTERS=16000
CONTEXT_MAX_SOURCES=12
EVIDENCE_MAX_CHARACTERS=2400
RETRIEVAL_MIN_SCORE=0.25
SEARCH_CACHE_SECONDS=300

# Document processing
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_BYTES=10485760
INGESTION_TIMEOUT_SECONDS=600
